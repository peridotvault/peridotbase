{
	"name": "@peridotbase/monorepo",
	"private": true,
	"type": "module",
	"description": "Peridotbase — a Solana-native, fully on-chain relational database. Monorepo for the Studio dashboard, the marketing site, and the TypeScript SDK.",
	"license": "Apache-2.0",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=22.23.4",
		"pnpm": ">=12.18.0"
	},
	"scripts": {
		"dev": "turbo run dev",
		"dev:studio": "turbo run dev --filter=@peridotbase/studio",
		"dev:web": "turbo run dev --filter=@peridotbase/web",
		"build": "turbo run build",
		"build:studio": "turbo run build --filter=@peridotbase/studio",
		"build:web": "turbo run build --filter=@peridotbase/web",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"format": "prettier --write \"**/*.{ts,tsx,astro,css,json,md,mdx,yaml,yml}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,astro,css,json,md,mdx,yaml,yml}\"",
		"knip": "knip",
		"clean": "turbo run clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo",
		"prepare": "husky"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"knip": "^6.45.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"turbo": "^2.11.10",
		"typescript": "^7.0.2"
	}
}
