{
	"name": "@peridotbase/sdk",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "TypeScript SDK for Peridotbase, a Solana-native on-chain relational database. Defines the protocol domain model and the client contract the Studio consumes.",
	"license": "Apache-2.0",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./types": "./src/types/index.ts"
	},
	"scripts": {
		"build": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@peridotbase/config": "workspace:*",
		"eslint": "^10.14.0",
		"typescript": "^7.0.2"
	}
}
