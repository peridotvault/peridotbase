{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"env": ["NODE_ENV", "VITE_STUDIO_DEMO"],
			"passThroughEnv": [
				"PUBLIC_SOLANA_RPC_URL",
				"PUBLIC_SOLANA_CLUSTER",
				"PUBLIC_SITE_URL",
				"VITE_STUDIO_DEMO"
			]
		},
		"@peridotbase/sdk#build": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"@peridotbase/config#build": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"@peridotbase/ui#build": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^build"],
			"outputs": [],
			"cache": true
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": [],
			"cache": true
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": [],
			"cache": true
		},
		"clean": {
			"cache": false
		},
		"@peridotbase/studio#dev:demo": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		}
	},
	"globalDependencies": ["tsconfig.json", "package.json", "turbo.json", ".env", ".env.local"],
	"globalEnv": ["NODE_ENV", "CI"]
}
