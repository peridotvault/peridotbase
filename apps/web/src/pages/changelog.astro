---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { changelog } from "../content-data/changelog";
---

<StarlightPage
	frontmatter={{
		title: "Changelog",
		description: "What changed in each Peridotbase Studio release.",
	}}
>
	<p class="lead">
		What changed in each release of the Studio, written for the people who use it.
	</p>

	{changelog.map((entry) => (
		<article class="entry">
			<header>
				<h2>{entry.title}</h2>
				<p class="meta">
					<code>v{entry.version}</code>
					<time datetime={entry.date}>{entry.date}</time>
				</p>
			</header>
			{entry.features && (
				<section>
					<h3>Features</h3>
					<ul>
						{entry.features.map((item) => (
							<li>{item.text}</li>
						))}
					</ul>
				</section>
			)}
			{entry.improvements && (
				<section>
					<h3>Improvements</h3>
					<ul>
						{entry.improvements.map((item) => (
							<li>{item.text}</li>
						))}
					</ul>
				</section>
			)}
			{entry.bugsFixed && (
				<section>
					<h3>Fixes</h3>
					<ul>
						{entry.bugsFixed.map((item) => (
							<li>{item.text}</li>
						))}
					</ul>
				</section>
			)}
		</article>
	))}
</StarlightPage>

<style>
	.lead {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-lg);
	}

	.entry {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
	}

	.entry h2 {
		margin: 0;
		font-size: var(--sl-text-h3);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0.35rem 0 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	.meta code {
		color: var(--sl-color-accent-high);
	}

	.entry section {
		margin-top: 1.1rem;
	}

	.entry h3 {
		margin: 0 0 0.4rem;
		font-size: var(--sl-text-sm);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sl-color-gray-3);
	}

	.entry ul {
		margin: 0;
		padding-left: 1.1rem;
	}
</style>
